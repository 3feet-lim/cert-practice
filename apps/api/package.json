{
  "name": "@cert-quiz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc6 -b --pretty false",
    "test": "vitest run src",
    "test:integration": "vitest run src --passWithNoTests",
    "test:cognito-live": "RUN_LIVE_COGNITO_AUTH_INTEGRATION=true vitest run src/cognito-production.integration.test.ts",
    "typecheck": "tsc6 -b --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@cert-quiz/contracts": "workspace:*",
    "@cert-quiz/db": "workspace:*",
    "@cert-quiz/domain": "workspace:*",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "vitest": "4.1.11"
  }
}

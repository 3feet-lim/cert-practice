{
  "name": "@cert-quiz/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc6 -b --pretty false",
    "typecheck": "tsc6 -b --pretty false",
    "test:repository": "vitest run src/in-memory-unit-of-work.test.ts src/lifecycle.property.test.ts src/migrations.test.ts",
    "test:spike": "vitest run src/spike",
    "spike:local": "pnpm run build && node dist/spike/cli.js --mode=local --dry-run",
    "spike:live": "pnpm run build && node dist/spike/live-cli.js",
    "spike:check": "pnpm run test:spike && pnpm run spike:local"
  },
  "dependencies": {
    "@aws/aurora-dsql-node-postgres-connector": "0.1.9",
    "@cert-quiz/domain": "workspace:*",
    "pg": "8.23.0",
    "pg-connection-string": "2.14.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "fast-check": "4.9.0",
    "vitest": "4.1.11"
  }
}
